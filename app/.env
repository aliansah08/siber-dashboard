# OpenSearch Configuration for Wazuh Integration
# Wazuh Server IP: localhost (running in Docker)
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=SecretPassword

# SSL Configuration (for Docker OpenSearch)
OPENSEARCH_SSL_CA=/home/wazuh/wazuh-docker/single-node/config/wazuh_indexer_ssl_certs/root-ca.pem
OPENSEARCH_SSL_REJECT_UNAUTHORIZED=false

# Wazuh Settings
WAZUH_INDEX_PATTERN=wazuh-alerts-*
ALERT_POLLING_INTERVAL=5000

# Server Configuration
PORT=3001
NODE_ENV=production

# Feature Flags
USE_MOCK_DATA=false
ENABLE_WEBHOOK=true

# Alert Filtering
MIN_ALERT_LEVEL=1
MAX_ALERTS_PER_BATCH=100

# GeoIP Enhancement (optional)
ENABLE_GEOIP=true
