# OpenSearch Configuration for Wazuh Integration
# Edit ini sesuai dengan server OpenSearch/Wazuh kamu

# URL OpenSearch (ubah jadi IP server Wazuh)
OPENSEARCH_URL=https://192.168.1.100:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=SecretPassword

# SSL Configuration
OPENSEARCH_SSL_CA=
OPENSEARCH_SSL_REJECT_UNAUTHORIZED=false

# Wazuh Settings
WAZUH_INDEX_PATTERN=wazuh-alerts-*
ALERT_POLLING_INTERVAL=5000

# Server Configuration
PORT=3001
NODE_ENV=production

# Feature Flags
USE_MOCK_DATA=false
ENABLE_WEBHOOK=true

# Alert Filtering
MIN_ALERT_LEVEL=1
MAX_ALERTS_PER_BATCH=100

# GeoIP Enhancement
ENABLE_GEOIP=true